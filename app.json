{
  "expo": {
    "name": "Utsav",
    "slug": "utsav",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-mark-only-dark.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "scheme": "utsav",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "web": {
      "favicon": "./assets/favicon-dark.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.utsav.events",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ],
        "NSSpeechRecognitionUsageDescription": "Allow Utsav to use speech recognition to turn what you say into your event plan.",
        "NSMicrophoneUsageDescription": "Allow Utsav to use the microphone so you can speak your event plan instead of typing it."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.utsav.events",
      "googleServicesFile": "./google-services.json",
      "ndkVersion": "27.1.12297006",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.theutsavapp.com",
              "pathPrefix": "/provider"
            },
            {
              "scheme": "utsav",
              "host": "provider"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "www.theutsavapp.com",
              "pathPrefix": "/event"
            },
            {
              "scheme": "utsav",
              "host": "event"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-contacts",
      "expo-media-library",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon-96.png",
          "color": "#E8A020"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Utsav to check your location once, only while this page is open, to see if you're near the event venue and offer a one-tap check-in.",
          "locationAlwaysAndWhenInUsePermission": "Allow Utsav to use your location in the background, only for events you've turned on auto check-in for, so it can check you in automatically when you arrive near the venue.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Utsav to use the microphone so you can speak your event plan instead of typing it.",
          "speechRecognitionPermission": "Allow Utsav to use speech recognition to turn what you say into your event plan."
        }
      ],
      [
        "react-native-share",
        {}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3710261d-bc4e-40b0-a9c2-0c50e7bd0c85"
      },
      "sentryDsn": "https://2b8a53853808a91dac419e9eb593245e@o4511926671572992.ingest.us.sentry.io/4511926721249281"
    },
    "owner": "anishdr",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3710261d-bc4e-40b0-a9c2-0c50e7bd0c85"
    }
  }
}
